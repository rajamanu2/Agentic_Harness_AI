{
  "name": "ai-salesforce-command-center-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React desktop shell for the AI Salesforce Command Center.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "dev:electron": "npm run electron:build && electron .",
    "electron:build": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && vite build && npm run electron:build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^41.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
